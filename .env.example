# --- Required -------------------------------------------------------------
# Photon project (https://app.photon.codes -> your project -> Settings).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Your own phone number in E.164 form. Only these senders are answered.
NANO_ALLOWED_USERS=+15551234567

# One model key. The default model is DeepSeek; set the key for whichever
# provider NANO_MODEL names (DEEPSEEK_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY, ...).
DEEPSEEK_API_KEY=
NANO_MODEL=deepseek/deepseek-flash

# --- Optional -------------------------------------------------------------
# Web search (https://brave.com/search/api). Without it Nano can still fetch pages.
BRAVE_SEARCH_API_KEY=
# Fallback timezone until Nano learns yours in the first conversation.
TZ=UTC
# Hours of silence before the next text starts a fresh context window.
NANO_IDLE_HOURS=4
# Packs to load (folders under packs/, or private ones under data/packs/).
NANO_PACKS=core
# Thinking effort: off, minimal, low, medium, high.
NANO_THINKING=low

