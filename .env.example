# --- Required -------------------------------------------------------------
# Photon project (https://app.photon.codes -> your project -> Settings).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Your own phone number in E.164 form. Only these senders are answered.
NANO_ALLOWED_USERS=+15551234567

# One model key. The default model is DeepSeek; set the key for whichever
# provider NANO_MODEL names (DEEPSEEK_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OPENROUTER_API_KEY, GEMINI_API_KEY, ...).
DEEPSEEK_API_KEY=
NANO_MODEL=deepseek/deepseek-flash

# --- Optional -------------------------------------------------------------
# Web search (https://brave.com/search/api). Without it Nano can still fetch pages.
BRAVE_SEARCH_API_KEY=
# Fallback timezone until Nano learns yours in the first conversation.
TZ=UTC
# Hours of silence before the next text starts a fresh context window.
NANO_IDLE_HOURS=4
# Packs to load (folders under packs/, or private ones under data/packs/).
# The vault pack's settings are in packs/vault/env.example.
NANO_PACKS=core
# Thinking effort: off, minimal, low, medium, high.
NANO_THINKING=low
# Background tasks (sub-sessions for heavy work): how many run at once, and when one is stopped.
NANO_MAX_TASKS=3
NANO_TASK_TIMEOUT_MINUTES=30

# Local model (optional): an OpenAI-compatible endpoint you run, e.g. llama.cpp or Ollama.
# Used for background tasks and scheduled jobs marked "local" or "private", the ask_local tool
# and the nano-local command. Work marked private is refused when this is unset; it never falls
# back to the cloud model. A private task's final answer does go to the main model.
# From inside Docker, reach the host as http://host.docker.internal:<port>/v1 (on Linux, map it
# with `extra_hosts: ["host.docker.internal:host-gateway"]` in compose.override.yaml).
NANO_LOCAL_MODEL=
NANO_LOCAL_BASE_URL=
NANO_LOCAL_API_KEY=
# Context window of the local model, in tokens.
NANO_LOCAL_CONTEXT=32768

