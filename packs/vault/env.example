# vault pack. Enable with NANO_PACKS=core,purchases,vault and rebuild the image.
# Nothing here is required. Defaults assume a tailnet address on this machine.

# Where secrets are stored. Must be a mount owned by the vault user, mode 0700.
# Not under the data directory: the agent can rename things there.
# NANO_VAULT_DIR=/vault

# Portal listen addresses, comma-separated. Default: the first local IPv4 address in Tailscale's
# CGNAT range (RFC 6598). Never defaults to every interface or to loopback.
# List explicit tailnet and LAN interface addresses to serve both networks.
# NANO_VAULT_BIND=

# Portal port. Default 8484.
# NANO_VAULT_PORT=8484

# Who may connect, as comma-separated address/prefix entries. Default is the
# same CGNAT range. Include the LAN subnet to permit local-network devices.
# A connection from this machine is still refused.
# NANO_VAULT_ALLOW=

# Extra Host names the portal accepts, besides the bind address (DNS rebinding).
# NANO_VAULT_HOSTS=

# Downloads the browser saves for the agent. Must be outside the vault and data
# directories. Default is /var/lib/nano-vault/downloads.
# NANO_VAULT_DOWNLOADS=

# Test-only. Read once at daemon start. The agent cannot set the daemon's
# environment. Leave these unset.
# NANO_VAULT_INSECURE_ALLOW_LOCAL=1    allow loopback clients to open the portal
# NANO_VAULT_ALLOW_HTTP_LOOPBACK=1     allow a saved login on http://127.0.0.1
# NANO_VAULT_INSECURE_TLS=1            do not verify TLS certificates
