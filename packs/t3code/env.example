# T3 Code handoff (packs/t3code). Needs the mcp pack: NANO_PACKS=core,mcp,t3code

# T3 Code server Nano talks to. With host networking (the default compose setup on the
# T3 Code machine) loopback reaches it. Otherwise use an address the container can reach.
NANO_T3CODE_URL=http://127.0.0.1:4096

# Address you open T3 Code at from your phone or laptop. Thread links Nano sends are
# rewritten from NANO_T3CODE_URL to this. Leave empty to send links unchanged.
NANO_T3CODE_WEB_URL=

# Default access level when pairing: read-only, approval-required, auto-accept-edits, auto, full-access
NANO_T3CODE_ACCESS=approval-required
