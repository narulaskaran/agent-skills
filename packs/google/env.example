# --- google pack (all optional) --------------------------------------------
# By default the owner connects Google over chat and Nano keeps its own
# credentials in $NANO_DATA_DIR/google/. Set these only to reuse credentials
# another program already owns. Nano reads them and never writes to them.

# google-auth "authorized user" JSON (needs at least refresh_token).
GOOGLE_TOKEN_FILE=
# Google OAuth client JSON ({"installed": {...}} or {"web": {...}}). Needed
# only if the token file has no client_id/client_secret.
GOOGLE_CLIENT_SECRET_FILE=
